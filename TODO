class AdvertisementFilter(FilterSet):
    class Meta:
        model = Advertisement
        fields = ['price', 'manufactured_year']

    min_price = filters.NumberFilter(field_name='price', lookup_expr='gte')
    max_price = filters.NumberFilter(field_name='price', lookup_expr='lte')
    min_year = filters.NumberFilter(field_name='manufactured_year', lookup_expr='gte')
    max_year = filters.NumberFilter(field_name='manufactured_year', lookup_expr='lte')
    region = filters.ModelChoiceFilter(queryset=Region.objects.all())
    mark = filters.ModelChoiceFilter(queryset=Mark.objects.all())

    is_negotiable = filters.BooleanFilter(field_name='is_negotiable')
    is_dealership = filters.BooleanFilter(field_name='is_dealership')
    is_lease_with_buyout = filters.BooleanFilter(field_name='is_lease_with_buyout')



